{
	"name": "spin-the-wheel",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"serve": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "npm run format:css && prettier --write .",
		"format:css": "stylelint \"**/*.css\" --fix --allow-empty-input",
		"check": "npm run check:format && npm run check:lint && npm run check:types",
		"check:format": "prettier --check .",
		"check:lint": "npm run check:lint:js && npm run check:lint:css",
		"check:lint:js": "eslint .",
		"check:lint:css": "stylelint \"**/*.css\" --allow-empty-input",
		"check:types": "tsc --noEmit",
		"prepare": "husky"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"not dead"
	],
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"autoprefixer": "10.6.1",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"globals": "17.12.0",
		"husky": "9.1.7",
		"postcss": "8.5.28",
		"prettier": "3.9.7",
		"stylelint": "16.26.1",
		"stylelint-config-pepelsbey": "1.6.0",
		"stylelint-order": "8.1.1",
		"typescript": "5.8.3",
		"typescript-eslint": "8.70.0",
		"vite": "6.4.3"
	}
}
